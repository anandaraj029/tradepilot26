# MongoDB connection string. Leave empty to run an in-memory MongoDB (dev only, auto-seeded).
MONGODB_URI=mongodb://127.0.0.1:27017/tradepilot_admin
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5173
# Default super admin created by the seed script
ADMIN_EMAIL=admin@tradepilot.ai
ADMIN_PASSWORD=Admin@123
